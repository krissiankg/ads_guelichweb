# Secrets for the Supabase Edge Functions.
# Copy this file to supabase/.env (git-ignored) and fill in the real values,
# then run ./deploy-all-functions.ps1 (or: npx supabase secrets set --env-file supabase/.env)
# NEVER commit supabase/.env.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: token for the reset-admin-password function (at least 32 random characters).
# Leave it unset to disable that function. Generate one with: openssl rand -hex 32
# ADMIN_RESET_TOKEN=
