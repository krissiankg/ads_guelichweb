# Supabase Configuration
# Copy this file to .env and replace with your actual Supabase credentials
# Get your credentials from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Tracking (optional). Nothing loads while these are empty.
# Meta Pixel ID from Meta Events Manager, and Google Analytics 4 ID (G-XXXXXXXXXX).
VITE_META_PIXEL_ID=
VITE_GA_ID=
